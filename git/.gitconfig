[include]
  path = ~/.config/git/local/.gitconfig

[core]
  # editor = code -w
  editor = vim
	fsmonitor = false

[user]
  name = Pat Sissons
  email = patricksissons@gmail.com
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHmyZRcVdeo/ctNuqNCp/zsqDfktGnIRNIeZEIGSltSK

[gpg]
  format = ssh

[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
	allowedSignersFile = /Users/patsissons/.config/git/allowed_signers

[commit]
  gpgsign = true
